<Project>
  <!-- Shared product information for every project in the solution. -->
  <PropertyGroup>
    <Product>Adventure Creator</Product>
    <Authors>Paul F.Johnson</Authors>
    <Company>Paul F.Johnson</Company>
    <Copyright>Copyright © 2026 Paul F.Johnson</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- One MAUI version for every machine (the workload's own $(MauiVersion) differs between installs, and
         CommunityToolkit.Maui needs 10.0.90 or later). -->
    <MauiPackageVersion>10.0.110</MauiPackageVersion>
  </PropertyGroup>
</Project>
